# SQLite by default -- zero setup, zero cost. Point this at a Postgres URL
# instead if you want to run one, but nothing here requires it.
DATABASE_URL=sqlite:///./sports_prediction.db

# Free shared key from TheSportsDB (https://www.thesportsdb.com/api.php).
# A personal key is a paid-Patreon perk, so this shared free key is what we
# use to stay at zero cost. TheSportsDB has rotated this value before ("3"
# -> "123"); if fetches start failing, check their API docs page for the
# current free key and update it here.
THESPORTSDB_API_KEY=123

# Ensemble weights for the 1X2 market. Must be internally consistent but do
# not need to sum to 1 -- they are renormalized at blend time.
ENSEMBLE_WEIGHT_ELO=0.30
ENSEMBLE_WEIGHT_POISSON=0.35
ENSEMBLE_WEIGHT_ML=0.35

HOME_ADVANTAGE_ELO=60
ELO_K_FACTOR=20

# --- Security -----------------------------------------------------------
# Session tokens are HMAC-signed with this value. The default in config.py is
# published in this repository, which means anyone who has read it can forge a
# token for any account -- including a superadmin. Set this to a long random
# string before exposing the API to a network. The app logs a warning at
# startup while the default is still in place.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Browser origins allowed to call this API. Comma-separated, or "*" for any.
# Name your real origins in production.
CORS_ALLOW_ORIGINS=*

# Brute-force limits, counted per client IP. In-process, so these are
# per-worker -- see app/api/rate_limit.py.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
CHAT_RATE_LIMIT_MESSAGES=40
CHAT_RATE_LIMIT_WINDOW_SECONDS=300

# --- Optional AI assistant rewriter -------------------------------------
# The chat assistant is fully functional with this disabled -- it parses your
# question, looks the answer up in the database and composes a reply from the
# rows it found. Enabling this adds a phrasing-only rewrite pass on top; it is
# forbidden from introducing any number or claim not already in the grounded
# text, and falls back to that text if the call fails.
#
# Point it at any OpenAI-compatible /chat/completions endpoint. A locally-run
# one (Ollama, llama.cpp server, LM Studio) keeps the zero-cost property.
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=llama3.2
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_TIMEOUT=20
