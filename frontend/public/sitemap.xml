<?xml version="1.0" encoding="UTF-8"?>
<!--
  The public marketing pages, plus one <url> per fixture currently live on
  /api/public/fixtures -- regenerated by backend/scripts/generate_sitemap.py,
  which the weekly/daily refresh workflow runs and commits back to the repo
  (see .github/workflows/refresh-predictions.yml) so this file never lists a
  match that's already kicked off or one that isn't previewable yet.

  If that step hasn't run yet in a given deployment (DATABASE_URL unset, a
  fresh checkout), this file still has the static pages below -- a smaller
  but still-correct sitemap, never a broken one.

  lastmod is left out rather than guessed: this file isn't generated from
  real per-page modification dates, and a fabricated one is worse than none.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://soccaintel.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://soccaintel.com/how-it-works</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://soccaintel.com/fixtures</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://soccaintel.com/responsible</loc>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://soccaintel.com/register</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://soccaintel.com/login</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
